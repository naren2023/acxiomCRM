<%- include('../partials/header', { title: 'Dashboard', useChartJs: true }) %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-4 py-4 flex-grow-1">
  <!-- Dashboard Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1">
        Welcome back, <%= currentUser.Name %>
      </h2>
      <p class="text-muted small mb-0">
        AcxiomCRM Executive Dashboard &bull; Role Scope: <span class="badge badge-role-<%= currentUser.Role %> text-white"><%= currentUser.Role %></span>
      </p>
    </div>
    <div class="d-flex gap-2">
      <a href="/leads/new" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-funnel me-1"></i> New Lead
      </a>
      <a href="/opportunities/new" class="btn btn-primary btn-sm shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> New Opportunity
      </a>
    </div>
  </div>

  <%- include('../partials/alerts') %>

  <!-- Mandatory KPI Cards (Section 17.11) -->
  <div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-primary-subtle text-primary me-3">
            <i class="bi bi-people-fill"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Customers</div>
            <h3 class="fw-bold mb-0 text-dark"><%= kpis.totalCustomers %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Leads -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-info-subtle text-info me-3">
            <i class="bi bi-funnel-fill"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Leads</div>
            <h3 class="fw-bold mb-0 text-dark"><%= kpis.totalLeads %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Open Leads -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-warning-subtle text-warning me-3">
            <i class="bi bi-lightning-charge-fill"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Open Leads</div>
            <h3 class="fw-bold mb-0 text-dark"><%= kpis.openLeads %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm bg-primary text-white">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-white bg-opacity-25 text-white me-3">
            <i class="bi bi-currency-rupee"></i>
          </div>
          <div>
            <div class="text-white-50 small fw-semibold">Total Pipeline Value</div>
            <h3 class="fw-bold mb-0 text-white">₹<%= Number(kpis.totalPipelineValue).toLocaleString() %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Opportunities -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-secondary-subtle text-secondary me-3">
            <i class="bi bi-briefcase-fill"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Opportunities</div>
            <h3 class="fw-bold mb-0 text-dark"><%= kpis.totalOpportunities %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Open Opportunities -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-primary-subtle text-primary me-3">
            <i class="bi bi-hourglass-split"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Open Opportunities</div>
            <h3 class="fw-bold mb-0 text-dark"><%= kpis.openOpportunities %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Won Opportunities -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-success-subtle text-success me-3">
            <i class="bi bi-trophy-fill"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Won Opportunities</div>
            <h3 class="fw-bold mb-0 text-success"><%= kpis.wonOpportunities %></h3>
          </div>
        </div>
      </div>
    </div>

    <!-- Lost Opportunities -->
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 kpi-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="kpi-icon bg-danger-subtle text-danger me-3">
            <i class="bi bi-x-octagon-fill"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Lost Opportunities</div>
            <h3 class="fw-bold mb-0 text-danger"><%= kpis.lostOpportunities %></h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mandatory Chart.js Visualizations (Section 17.12) -->
  <div class="row g-4 mb-4">
    <!-- Chart 1: Lead Status -->
    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
          <span class="fw-bold"><i class="bi bi-pie-chart-fill me-1 text-primary"></i> Lead Status Breakdown</span>
        </div>
        <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 280px;">
          <canvas id="leadStatusChart" height="240"></canvas>
        </div>
      </div>
    </div>

    <!-- Chart 2: Opportunity Pipeline by Stage -->
    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
          <span class="fw-bold"><i class="bi bi-bar-chart-steps me-1 text-primary"></i> Pipeline by Stage (₹)</span>
        </div>
        <div class="card-body" style="min-height: 280px;">
          <canvas id="oppPipelineChart" height="240"></canvas>
        </div>
      </div>
    </div>

    <!-- Chart 3: Monthly Sales / Won Outlines -->
    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
          <span class="fw-bold"><i class="bi bi-graph-up-arrow me-1 text-primary"></i> Monthly Won Sales (₹)</span>
        </div>
        <div class="card-body" style="min-height: 280px;">
          <canvas id="monthlySalesChart" height="240"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Upcoming Follow-Ups Widget -->
  <div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-bold"><i class="bi bi-calendar-check me-1 text-primary"></i> Upcoming Follow-Up Schedule</span>
      <a href="/followups" class="btn btn-sm btn-outline-primary">View All Activities</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 small">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Client / Lead</th>
            <th>Remarks</th>
            <th>Assigned To</th>
          </tr>
        </thead>
        <tbody>
          <% if (upcomingFollowUps.length === 0) { %>
            <tr><td colspan="5" class="text-center py-4 text-muted">No pending follow-ups scheduled.</td></tr>
          <% } %>
          <% upcomingFollowUps.forEach(f => { %>
            <tr>
              <td><code><%= f.FollowUpDate %></code></td>
              <td><span class="badge bg-secondary"><%= f.FollowUpType %></span></td>
              <td class="fw-semibold"><%= f.CustomerName || f.LeadName || '-' %></td>
              <td><%= f.Remarks %></td>
              <td><%= f.AssignedName || currentUser.Name %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- Chart.js Setup Script -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // Chart 1: Lead Status
  const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
  new Chart(leadCtx, {
    type: 'doughnut',
    data: {
      labels: <%- JSON.stringify(charts.leadLabels) %>,
      datasets: [{
        data: <%- JSON.stringify(charts.leadData) %>,
        backgroundColor: ['#0dcaf0', '#0d6efd', '#198754', '#6c757d', '#6f42c1', '#dc3545'],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { position: 'bottom' }
      }
    }
  });

  // Chart 2: Opportunity Pipeline
  const oppCtx = document.getElementById('oppPipelineChart').getContext('2d');
  new Chart(oppCtx, {
    type: 'bar',
    data: {
      labels: <%- JSON.stringify(charts.oppLabels) %>,
      datasets: [{
        label: 'Pipeline Value (₹)',
        data: <%- JSON.stringify(charts.oppData) %>,
        backgroundColor: ['#0dcaf0', '#0d6efd', '#ffc107', '#198754', '#dc3545'],
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: (val) => '₹' + Number(val).toLocaleString()
          }
        }
      },
      plugins: {
        legend: { display: false }
      }
    }
  });

  // Chart 3: Monthly Sales
  const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
  new Chart(salesCtx, {
    type: 'line',
    data: {
      labels: <%- JSON.stringify(charts.monthLabels) %>,
      datasets: [{
        label: 'Won Revenue (₹)',
        data: <%- JSON.stringify(charts.monthData) %>,
        borderColor: '#198754',
        backgroundColor: 'rgba(25, 135, 84, 0.1)',
        tension: 0.3,
        fill: true,
        pointRadius: 4
      }]
    },
    options: {
      responsive: true,
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: (val) => '₹' + Number(val).toLocaleString()
          }
        }
      }
    }
  });
});
</script>

<%- include('../partials/footer') %>
