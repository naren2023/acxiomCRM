<%- include('../partials/header', { title: customer.CustomerName }) %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-4 py-4 flex-grow-1">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="fw-bold mb-0"><%= customer.CustomerName %></h2>
        <span class="badge <%= customer.Status === 'Active' ? 'bg-success' : 'bg-secondary' %>"><%= customer.Status %></span>
        <code><%= customer.CustomerCode %></code>
      </div>
      <p class="text-muted small mb-0"><%= customer.CompanyName || 'Independent Client' %> &bull; <%= customer.City ? customer.City + ', ' : '' %><%= customer.State || '' %></p>
    </div>
    <div class="d-flex gap-2">
      <a href="/customers/<%= customer.CustomerId %>/edit" class="btn btn-primary">
        <i class="bi bi-pencil me-1"></i> Edit Customer
      </a>
      <a href="/opportunities/new?customerId=<%= customer.CustomerId %>" class="btn btn-outline-primary">
        <i class="bi bi-plus-circle me-1"></i> Add Opportunity
      </a>
      <a href="/followups/new?customerId=<%= customer.CustomerId %>" class="btn btn-outline-primary">
        <i class="bi bi-calendar-plus me-1"></i> Add Follow-Up
      </a>
      <a href="/customers" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
      </a>
    </div>
  </div>

  <%- include('../partials/alerts') %>

  <div class="row g-4">
    <!-- Profile Card -->
    <div class="col-lg-4">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white">
          <i class="bi bi-building me-1 text-primary"></i> Account Details
        </div>
        <div class="card-body">
          <ul class="list-group list-group-flush small">
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Customer Code:</span>
              <span class="fw-semibold"><%= customer.CustomerCode %></span>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Email:</span>
              <a href="mailto:<%= customer.Email %>" class="text-decoration-none fw-semibold"><%= customer.Email %></a>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Phone:</span>
              <a href="tel:<%= customer.Phone %>" class="text-decoration-none fw-semibold"><%= customer.Phone %></a>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Company:</span>
              <span class="fw-semibold"><%= customer.CompanyName || '-' %></span>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Address:</span>
              <span class="fw-semibold text-end"><%= customer.Address || '-' %></span>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">City / State:</span>
              <span class="fw-semibold"><%= customer.City || '-' %> / <%= customer.State || '-' %></span>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Assigned Owner:</span>
              <span class="badge bg-light text-dark border"><%= customer.OwnerName || 'Unassigned' %></span>
            </li>
            <li class="list-group-item px-0 d-flex justify-content-between">
              <span class="text-muted">Created Date:</span>
              <span><%= new Date(customer.CreatedDate).toLocaleDateString() %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Opportunities & Follow-ups tabs -->
    <div class="col-lg-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <span class="fw-bold"><i class="bi bi-briefcase me-1 text-primary"></i> Linked Opportunities (<%= opportunities.length %>)</span>
          <a href="/opportunities/new?customerId=<%= customer.CustomerId %>" class="btn btn-sm btn-outline-primary">+ New</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
              <tr>
                <th>Opportunity Name</th>
                <th>Stage</th>
                <th>Amount</th>
                <th>Probability</th>
                <th>Close Date</th>
                <th>Assigned</th>
              </tr>
            </thead>
            <tbody>
              <% if (opportunities.length === 0) { %>
                <tr><td colspan="6" class="text-center py-3 text-muted">No opportunities registered yet.</td></tr>
              <% } %>
              <% opportunities.forEach(opp => { %>
                <tr>
                  <td><a href="/opportunities/<%= opp.OpportunityId %>" class="fw-semibold text-decoration-none"><%= opp.OpportunityName %></a></td>
                  <td><span class="badge bg-info text-dark"><%= opp.Stage %></span></td>
                  <td class="fw-semibold">₹<%= opp.Amount.toLocaleString() %></td>
                  <td><%= opp.Probability %>%</td>
                  <td><%= opp.ExpectedCloseDate %></td>
                  <td><%= opp.OwnerName || '-' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <span class="fw-bold"><i class="bi bi-calendar-check me-1 text-primary"></i> Scheduled Follow-ups (<%= followups.length %>)</span>
          <a href="/followups/new?customerId=<%= customer.CustomerId %>" class="btn btn-sm btn-outline-primary">+ New</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Remarks</th>
                <th>Status</th>
                <th>Assigned To</th>
              </tr>
            </thead>
            <tbody>
              <% if (followups.length === 0) { %>
                <tr><td colspan="5" class="text-center py-3 text-muted">No follow-ups recorded yet.</td></tr>
              <% } %>
              <% followups.forEach(f => { %>
                <tr>
                  <td><code><%= f.FollowUpDate %></code></td>
                  <td><span class="badge bg-secondary"><%= f.FollowUpType %></span></td>
                  <td><%= f.Remarks %></td>
                  <td><span class="badge <%= f.Status === 'Completed' ? 'bg-success' : (f.Status === 'Planned' ? 'bg-warning text-dark' : 'bg-danger') %>"><%= f.Status %></span></td>
                  <td><%= f.AssignedName || '-' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
