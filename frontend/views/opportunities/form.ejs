<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container py-4 flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <h2 class="fw-bold mb-1"><%= title %></h2>
          <p class="text-muted small mb-0">Record and progress commercial sales opportunities</p>
        </div>
        <a href="/opportunities" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Back to Opportunities
        </a>
      </div>

      <%- include('../partials/alerts') %>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <form action="<%= isEdit ? '/opportunities/' + opportunity.OpportunityId + '/edit' : '/opportunities' %>" method="POST" data-validate="true" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="row g-3">
              <div class="col-md-12">
                <label for="OpportunityName" class="form-label fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="OpportunityName" name="OpportunityName" value="<%= opportunity.OpportunityName || '' %>" required maxlength="150" placeholder="e.g. Enterprise CRM License Expansion" data-field-name="Opportunity Name">
              </div>

              <div class="col-md-6">
                <label for="CustomerId" class="form-label fw-semibold">Associated Customer <span class="text-danger">*</span></label>
                <select class="form-select" id="CustomerId" name="CustomerId" required data-field-name="Customer">
                  <option value="">-- Select Customer --</option>
                  <% customers.forEach(c => { %>
                    <option value="<%= c.CustomerId %>" <%= (opportunity.CustomerId == c.CustomerId) ? 'selected' : '' %>>
                      <%= c.CustomerName %> (<%= c.CustomerCode %>)
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="col-md-6">
                <label for="Amount" class="form-label fw-semibold">Deal Amount (₹) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" min="1" class="form-control" id="Amount" name="Amount" value="<%= opportunity.Amount || '' %>" required data-type="amount" data-field-name="Opportunity Amount">
                <div class="form-text small">Must be greater than 0</div>
              </div>

              <div class="col-md-6">
                <label for="Stage" class="form-label fw-semibold">Pipeline Stage <span class="text-danger">*</span></label>
                <select class="form-select" id="Stage" name="Stage" required onchange="handleStageChange(this.value)">
                  <% const stages = ['Qualification', 'Proposal', 'Negotiation', 'Won', 'Lost']; %>
                  <% stages.forEach(st => { %>
                    <option value="<%= st %>" <%= (opportunity.Stage === st) ? 'selected' : '' %>><%= st %></option>
                  <% }); %>
                </select>
              </div>

              <div class="col-md-6">
                <label for="Probability" class="form-label fw-semibold">Win Probability (%) <span class="text-danger">*</span></label>
                <input type="number" min="0" max="100" class="form-control" id="Probability" name="Probability" value="<%= opportunity.Probability !== undefined ? opportunity.Probability : 50 %>" required data-type="probability" data-field-name="Probability">
                <div class="form-text small">Value between 0 and 100</div>
              </div>

              <div class="col-md-6">
                <label for="ExpectedCloseDate" class="form-label fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                <input type="date" class="form-control" id="ExpectedCloseDate" name="ExpectedCloseDate" value="<%= opportunity.ExpectedCloseDate || '' %>" required data-field-name="Expected Close Date">
                <div class="form-text small">Cannot be in the past for active opportunities</div>
              </div>

              <% if (currentUser.Role === 'Admin' || currentUser.Role === 'Manager') { %>
                <div class="col-md-6">
                  <label for="AssignedTo" class="form-label fw-semibold">Assigned Deal Owner</label>
                  <select class="form-select" id="AssignedTo" name="AssignedTo">
                    <% salesUsers.forEach(u => { %>
                      <option value="<%= u.UserId %>" <%= (opportunity.AssignedTo == u.UserId) ? 'selected' : '' %>>
                        <%= u.Name %> (<%= u.Role %>)
                      </option>
                    <% }); %>
                  </select>
                </div>
              <% } %>

              <div class="col-md-12">
                <label for="Notes" class="form-label fw-semibold">Deal Notes & Commercial Context</label>
                <textarea class="form-control" id="Notes" name="Notes" rows="3" placeholder="Key stakeholders, competitive landscape, milestone expectations..."><%= opportunity.Notes || '' %></textarea>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
              <a href="/opportunities" class="btn btn-outline-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-check2-circle me-1"></i> <%= isEdit ? 'Update Opportunity' : 'Save Opportunity' %>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
function handleStageChange(stage) {
  const probInput = document.getElementById('Probability');
  if (stage === 'Won') {
    probInput.value = 100;
  } else if (stage === 'Lost') {
    probInput.value = 0;
  }
}
</script>

<%- include('../partials/footer') %>
