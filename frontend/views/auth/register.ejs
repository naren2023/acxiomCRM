<%- include('../partials/header', { title: 'Register' }) %>
<%- include('../partials/navbar') %>

<main class="container my-auto py-5 flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <div class="text-center mb-4">
            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
              <i class="bi bi-person-plus-fill fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1">Create an Account</h3>
            <p class="text-muted small">Join AcxiomCRM to manage leads and opportunities</p>
          </div>

          <%- include('../partials/alerts') %>

          <form action="/register" method="POST" data-validate="true" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label for="name" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="name" name="Name" value="<%= typeof oldInput !== 'undefined' && oldInput.Name ? oldInput.Name : '' %>" placeholder="John Doe" required data-field-name="Full Name" maxlength="100">
            </div>

            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="email" name="Email" value="<%= typeof oldInput !== 'undefined' && oldInput.Email ? oldInput.Email : '' %>" placeholder="johndoe@acxiom.com" required data-type="email" data-field-name="Email Address" maxlength="150">
            </div>

            <div class="mb-3">
              <label for="role" class="form-label fw-semibold">User Role <span class="text-danger">*</span></label>
              <select class="form-select" id="role" name="Role" required>
                <option value="SalesExecutive" <%= typeof oldInput !== 'undefined' && oldInput.Role === 'SalesExecutive' ? 'selected' : '' %>>Sales Executive</option>
                <option value="Manager" <%= typeof oldInput !== 'undefined' && oldInput.Role === 'Manager' ? 'selected' : '' %>>Sales Manager</option>
                <option value="Admin" <%= typeof oldInput !== 'undefined' && oldInput.Role === 'Admin' ? 'selected' : '' %>>System Admin</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="password" class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="password" name="Password" placeholder="••••••••" required data-password-policy="true" data-field-name="Password">
              <div class="form-text small text-muted">
                Must contain at least 8 characters, with at least one uppercase letter, one lowercase letter, and one number.
              </div>
            </div>

            <div class="mb-4">
              <label for="confirmPassword" class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="confirmPassword" name="ConfirmPassword" placeholder="••••••••" required data-field-name="Confirm Password">
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
              <i class="bi bi-person-check-fill me-1"></i> Register Account
            </button>
          </form>

          <div class="text-center mt-4 small">
            Already have an account? <a href="/login" class="text-decoration-none fw-semibold">Sign in here</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
